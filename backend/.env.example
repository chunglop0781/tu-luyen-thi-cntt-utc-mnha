# ───── GitHub (bắt buộc) ─────
# Token (classic: scope "repo" + "admin:repo_hook"; hoặc fine-grained: Contents RW, Administration RW, Webhooks RW trên các repo)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_BRANCH=main

# Repo PRIVATE chứa tài khoản + phiên đăng nhập (cookies/session) — cron tự dọn commit cũ hơn 5 ngày
ACCOUNT_GITHUB_REPO=tu-luyen-thi-cntt-utc-mnha-account
# Repo PRIVATE chứa bài tự luận / trắc nghiệm / bài nộp của từng tài khoản — KHÔNG dọn commit
DATA_GITHUB_REPO=tu-luyen-thi-cntt-utc-mnha-data
# Repo ảnh (mã hoá AES-256-GCM): <prefix>, <prefix>-1, <prefix>-2 ... tự sinh khi đầy
IMAGE_REPO_PREFIX=tu-luyen-thi-cntt-utc-mnha-image
IMAGE_REPO_LIMIT_MB=200
IMAGE_REPO_RESERVE_MB=8

# ───── Bảo mật (bắt buộc) ─────
# Chuỗi ngẫu nhiên dài >= 32 ký tự:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=
# Dùng chung cho mọi webhook GitHub → /webhooks/github
GITHUB_WEBHOOK_SECRET=
# Vercel Cron tự gửi "Authorization: Bearer <CRON_SECRET>" khi biến này được đặt
CRON_SECRET=

# ───── Kết nối GitHub Pages ↔ Vercel ─────
# Origin của GitHub Pages (chỉ scheme + host, KHÔNG có /tên-repo). Nhiều origin: ngăn cách bằng dấu phẩy
FRONTEND_ORIGINS=https://TEN_GITHUB.github.io
# URL công khai của backend (để tự gắn webhook cho repo ảnh mới). Mặc định lấy từ VERCEL_PROJECT_PRODUCTION_URL
PUBLIC_API_URL=https://TEN-PROJECT.vercel.app

# ───── Tuỳ chọn ─────
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
BCRYPT_ROUNDS=10
REGISTRATION_OPEN=true
INVITE_CODE=
PRUNE_DAYS=5
PRUNE_MAX_REPLAY=150
GEMINI_MODEL=gemini-2.5-flash
ALLOW_LOCALHOST=false
